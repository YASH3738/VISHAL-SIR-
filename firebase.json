{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".agents/**",
      ".claude/**",
      ".vscode/**",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "package.json",
      "package-lock.json",
      "README.md",
      "**/*.md",
      "**/*.log",
      "rzp-key*.csv"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "vishal-clinic-api",
          "region": "asia-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
